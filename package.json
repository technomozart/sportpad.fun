{
  "name": "sportpad-fun",
  "version": "0.1.0",
  "private": true,
  "description": "A transparent Solana sports-community launchpad with official Fan Token reward planning.",
  "homepage": "https://sportpad.fun",
  "repository": {
    "type": "git",
    "url": "https://github.com/technomozart/sportpad.fun.git"
  },
  "bugs": {
    "url": "https://github.com/technomozart/sportpad.fun/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "test:protocol": "node --experimental-strip-types --test lib/protocol/*.test.ts",
    "test:providers": "node --experimental-strip-types --test lib/server/providers/*.test.ts",
    "audit:chiliz": "node --experimental-strip-types scripts/audit-chiliz-v2-markets.mjs",
    "test:wallets": "node --experimental-strip-types --test components/solana-wallet-providers.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "worker:automation": "node --experimental-strip-types scripts/automation-worker.mjs",
    "worker:solana": "node scripts/solana-automation-worker.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@layerzerolabs/lz-v2-utilities": "3.0.168",
    "@layerzerolabs/oft-v2-solana-sdk": "3.0.168",
    "@metaplex-foundation/umi": "0.9.2",
    "@metaplex-foundation/umi-bundle-defaults": "0.9.2",
    "@noble/curves": "^1.9.7",
    "@shadcn/react": "^0.3.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "1.95.8",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "viem": "^2.56.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.56.0",
    "@cloudflare/workers-types": "5.20260918.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.1.0",
    "wrangler": "4.135.0"
  },
  "type": "module",
  "overrides": {
    "image-size": "2.0.4",
    "miniflare": {
      "sharp": "0.35.4"
    },
    "ws@>=8.0.0": "8.21.3"
  }
}
