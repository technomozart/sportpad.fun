# Server-only RPC/indexing and quote-provider credentials
HELIUS_API_KEY=
JUPITER_API_KEY=

# Optional phase-two cross-chain inventory replenishment
LAYERZERO_API_KEY=
CHILIZ_RPC_URL=

# Signers are references to a KMS/HSM/MPC policy, never raw private keys.
SOLANA_FEE_COLLECTOR_KEY_REF=
SOLANA_REWARD_VAULT_KEY_REF=
SOLANA_BUYBACK_EXECUTOR_KEY_REF=
CHILIZ_REPLENISHER_KEY_REF=

# Mainnet actions remain disabled until an audit and canary pass.
MAINNET_EXECUTION_ENABLED=false

# Public submissions fail closed unless this is explicitly set to moderated or operator_only.
SPORTPAD_PUBLICATION_MODE=closed

# Exact Sites authenticated user IDs, comma-separated. Never authorize operators by wallet or client input.
SPORTPAD_OPERATOR_USER_IDS=

# Keep false unless a single-operator devnet beta explicitly accepts self-review with an audit event.
SPORTPAD_ALLOW_SELF_REVIEW=false
