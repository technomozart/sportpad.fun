# Server-only RPC/indexing and quote-provider credentials
HELIUS_API_KEY=
JUPITER_API_KEY=
# Production Value Transfer key for bounded quote/build/status checks only.
# Do not expose to browser code; this key does not by itself enable execution.
LAYERZERO_VT_API_KEY=

# Chiliz Chain route checks and the public automated treasury address.
CHILIZ_RPC_URL=
CHILIZ_TREASURY_ADDRESS=
CHILIZ_AUTOMATION_ENABLED=false

# Signers are references to a KMS/HSM/MPC policy, never raw private keys.
SPORTPAD_SIGNER_PROVIDER=
SOLANA_FEE_COLLECTOR_KEY_REF=
SOLANA_REWARD_VAULT_KEY_REF=
SOLANA_BUYBACK_EXECUTOR_KEY_REF=
CHILIZ_REPLENISHER_KEY_REF=

# Authenticates scheduler calls to internal worker endpoints. Use a generated,
# high-entropy secret and never expose it to browser code.
SPORTPAD_WORKER_TOKEN=

# Public Solana addresses. These are safe to expose and are never private keys.
# The two treasury addresses must be different and must not be a creator wallet.
SOLANA_REWARD_TREASURY_ADDRESS=
SOLANA_BUYBACK_TREASURY_ADDRESS=

# May stay empty until the SPORTPAD token is launched. Buyback proceeds accrue
# in the buyback treasury until this mint is configured and execution is audited.
SPORTPAD_MINT_ADDRESS=

# Mainnet actions remain disabled until an audit and canary pass.
MAINNET_EXECUTION_ENABLED=false

# Every execution lane is independently locked. Enabling a lane is not enough:
# its managed signer reference, worker token, database pause control, and other
# lane-specific prerequisites must also be satisfied.
SPORTPAD_FEE_INDEXER_ENABLED=false
SPORTPAD_SETTLEMENT_ENABLED=false
SPORTPAD_REWARDS_ENABLED=false
SPORTPAD_HOLDER_INDEXER_ENABLED=false
SPORTPAD_CLAIMS_ENABLED=false
SPORTPAD_BUYBACK_ENABLED=false

# Public submissions fail closed unless this is explicitly set to moderated or operator_only.
SPORTPAD_PUBLICATION_MODE=closed

# Exact Sites authenticated user IDs, comma-separated. Never authorize operators by wallet or client input.
SPORTPAD_OPERATOR_USER_IDS=

# Keep false unless a single-operator devnet beta explicitly accepts self-review with an audit event.
SPORTPAD_ALLOW_SELF_REVIEW=false
